option('enable_openmp', type: 'boolean', value: false, 
  description: 'Enable OpenMP multi-threading for CPU execution')

option('accel', type: 'combo', choices: ['none', 'multicore', 'gpu'], value: 'none', 
  description: 'Hardware acceleration target (requires nvfortran)')

option('cpu_baseline', type: 'combo', choices: ['generic', 'native', 'x86-64-v3'], value: 'generic',
  description: 'CPU instruction set optimization level')

option('enable_stress_testing', type: 'boolean', value: false,
  description: 'Build and register stress-test executables for CI and profiling')

option('kernel_precision', type: 'combo', choices: ['double', 'single'], value: 'double',
  description: 'Precision of the per-pixel kernels (spectral templates, SSP/CSP sums, dust, nebular, photometry); setup, isochrones and weights stay double')
